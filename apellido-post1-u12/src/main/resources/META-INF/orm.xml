<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mapeo JPA externo al dominio: la clase SolicitudReembolso no importa jakarta.persistence.
  La persistencia es un detalle de infraestructura y se describe aqui, fuera del modelo.
-->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_0.xsd"
                 version="3.0">
    <entity class="com.empresa.reembolsos.dominio.SolicitudReembolso" access="FIELD">
        <table name="solicitud_reembolso"/>
        <attributes>
            <id name="id">
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="empleadoId"/>
            <basic name="categoria">
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="montoSolicitado">
                <column precision="15" scale="2"/>
            </basic>
            <basic name="montoAprobado">
                <column precision="15" scale="2"/>
            </basic>
            <basic name="fechaGasto"/>
            <basic name="diasViaje"/>
            <basic name="documentosSoporte"/>
            <basic name="estado">
                <enumerated>STRING</enumerated>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
